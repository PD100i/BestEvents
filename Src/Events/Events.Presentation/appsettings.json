{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=events;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "Issuer": "Users",
    "Audience": "UsersApi",
    "ExpiryInMinutes": 30
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "RedisSettings": {
    "Endpoints": [
      {
        "Host": "localhost",
        "Port": 6379
      }
    ],
    "Password": "",
    "ConnectTimeout": 5000,
    "SyncTimeout": 3000,
    "AllowAdmin": false,
    "GetEvntTTL_sec": 60,
    "GetTopEvntsTTL_sec": 60
  },
  "AllowedHosts": "*"
}
